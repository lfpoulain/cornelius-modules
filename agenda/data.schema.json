{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgendaData v3",
  "description": "Le lien de l’agenda n’y figure jamais : il ne vit que dans les réglages de la source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "from", "days", "truncated", "events"],
  "properties": {
    "name": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "from": {
      "type": "string",
      "format": "date-time",
      "description": "Premier jour lu, à minuit dans le fuseau du foyer."
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "truncated": {
      "type": "boolean",
      "description": "Fichier coupé à sa taille maximale : les derniers événements peuvent manquer."
    },
    "events": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "location", "description", "start", "end", "allDay"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "location": {
            "type": ["string", "null"],
            "maxLength": 200
          },
          "description": {
            "type": ["string", "null"],
            "maxLength": 1000
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "allDay": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
