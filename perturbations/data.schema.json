{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["perturbations", "total", "filtre"],
  "properties": {
    "perturbations": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lignes", "reseaux", "lieux", "texte", "fin", "cause"],
        "properties": {
          "lignes": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 24 }
          },
          "reseaux": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "minLength": 3, "maxLength": 40 }
          },
          "lieux": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "texte": { "type": "string", "minLength": 1, "maxLength": 300 },
          "fin": { "type": ["string", "null"], "maxLength": 40 },
          "cause": { "type": ["string", "null"], "maxLength": 120 }
        }
      }
    },
    "total": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "filtre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lignes", "arrets"],
      "properties": {
        "lignes": {
          "type": "array",
          "maxItems": 60,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "arrets": {
          "type": "array",
          "maxItems": 60,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
