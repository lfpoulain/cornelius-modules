{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RadioData v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["poste", "pays"],
  "properties": {
    "poste": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 80
    },
    "pays": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$"
    }
  }
}
